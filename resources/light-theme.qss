/* Obsession Light Theme - Modern light color scheme for Qt 6 */

/* Base colors:
 * Background: #ffffff (white), #f5f5f5 (light gray), #e8e8e8 (medium gray)
 * Text: #1e1e1e (dark), #333333 (medium dark)
 * Accent: #0078d4 (blue for selection/focus)
 * Border: #d0d0d0 (subtle borders)
 * Hover: #e5f1fb
 */

/* Global Widget Styles */
QWidget {
    background-color: #ffffff;
    color: #1e1e1e;
    font-family: "Segoe UI", Arial, sans-serif;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #f5f5f5;
}

/* Buttons */
QPushButton {
    background-color: #f5f5f5;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #e5f1fb;
    border-color: #0078d4;
}

QPushButton:pressed {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #005a9e;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border-color: #e0e0e0;
}

QPushButton:default {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #005a9e;
}

/* Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0078d4;
    outline: none;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border-color: #e0e0e0;
}

/* Combo Boxes */
QComboBox {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #0078d4;
}

QComboBox:focus {
    border-color: #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #1e1e1e;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    outline: none;
}

/* Spin Boxes */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0078d4;
}

/* List Widgets */
QListWidget, QListView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    outline: none;
}

QListWidget::item, QListView::item {
    padding: 4px 8px;
    background: transparent;  /* Explicitly transparent to show custom backgrounds */
    /* Note: Individual items can override this with custom backgrounds (e.g., user icons) */
}

QListWidget::item:hover, QListView::item:hover {
    /* Note: background-color intentionally not set to preserve user icon backgrounds */
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QListWidget::item:selected:!active, QListView::item:selected:!active {
    background-color: #0078d4;
    color: #ffffff;
}

QListWidget::item:selected:active, QListView::item:selected:active {
    background-color: #0078d4;
    color: #ffffff;
}

/* Table Widgets */
QTableWidget, QTableView {
    background-color: #ffffff;
    color: #1e1e1e;
    gridline-color: #e0e0e0;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 4px 8px;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #e5f1fb;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f5f5f5;
    color: #1e1e1e;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #d0d0d0;
    border-right: 1px solid #e0e0e0;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #e5f1fb;
}

/* Tree Widgets */
QTreeWidget, QTreeView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    outline: none;
}

QTreeWidget::item, QTreeView::item {
    padding: 4px 8px;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #e5f1fb;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QTreeWidget::item:selected:!active, QTreeView::item:selected:!active {
    background-color: #0078d4;
    color: #ffffff;
}

QTreeWidget::item:selected:active, QTreeView::item:selected:active {
    background-color: #0078d4;
    color: #ffffff;
}

QTreeWidget::branch {
    background-color: #ffffff;
}

/* Menu Bar */
QMenuBar {
    background-color: #f5f5f5;
    color: #1e1e1e;
    border-bottom: 1px solid #d0d0d0;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #e5f1fb;
}

QMenuBar::item:pressed {
    background-color: #0078d4;
    color: #ffffff;
}

/* Menus */
QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #e5f1fb;
}

QMenu::item:disabled {
    color: #a0a0a0;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f5f5f5;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #e5f1fb;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 14px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 7px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 14px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 7px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Dialogs */
QDialog {
    background-color: #ffffff;
    color: #1e1e1e;
}

/* Group Boxes */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    color: #1e1e1e;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    background-color: #ffffff;
    color: #0078d4;
}

/* Check Boxes */
QCheckBox {
    color: #1e1e1e;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #0078d4;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    image: none;
}

QCheckBox::indicator:checked:hover {
    background-color: #005a9e;
}

QCheckBox::indicator:disabled {
    background-color: #f5f5f5;
    border-color: #e0e0e0;
}

/* Radio Buttons */
QRadioButton {
    color: #1e1e1e;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #0078d4;
}

QRadioButton::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

QRadioButton::indicator:checked:hover {
    background-color: #005a9e;
}

/* Toolbars */
QToolBar {
    background-color: #f5f5f5;
    border: none;
    border-bottom: 1px solid #d0d0d0;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #1e1e1e;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QToolButton:hover {
    background-color: #e5f1fb;
}

QToolButton:pressed {
    background-color: #0078d4;
    color: #ffffff;
}

/* Status Bar */
QStatusBar {
    background-color: #0078d4;
    color: #ffffff;
    border-top: 1px solid #005a9e;
}

QStatusBar::item {
    border: none;
}

/* Progress Bars */
QProgressBar {
    background-color: #e8e8e8;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    text-align: center;
    color: #1e1e1e;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 3px;
}

/* Sliders */
QSlider::groove:horizontal {
    background-color: #e8e8e8;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #0078d4;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #005a9e;
}

QSlider::groove:vertical {
    background-color: #e8e8e8;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background-color: #0078d4;
    width: 16px;
    height: 16px;
    margin: 0 -5px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background-color: #005a9e;
}

/* Tool Tips */
QToolTip {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Splitters */
QSplitter::handle {
    background-color: #d0d0d0;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}
